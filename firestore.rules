rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /conversations/{docId} {
      // Lecture ouverte à tous (démo : aucune donnée personnelle).
      allow read: if true;
      // Création : exactement trois champs, tailles bornées.
      allow create: if request.resource.data.keys().hasOnly(['question', 'answer', 'createdAt'])
                    && request.resource.data.keys().hasAll(['question', 'answer', 'createdAt'])
                    && request.resource.data.question is string
                    && request.resource.data.question.size() > 0
                    && request.resource.data.question.size() <= 2000
                    && request.resource.data.answer is string
                    && request.resource.data.answer.size() > 0
                    && request.resource.data.answer.size() <= 8000
                    && request.resource.data.createdAt == request.time;
      // Aucune modification, aucune suppression.
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
